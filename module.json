{
  "id": "drama-director-hub",
  "title": "Drama Director — Hub",
  "description": "Common hub for the Drama Director module family. Provides the sidebar button, shared API, settings migration from the legacy single-module 'drama-director'. Required by drama-director-cinematic, drama-director-footsteps, drama-director-novella and drama-director-textpics.",
  "version": "2.0",
  "compatibility": {
    "minimum": "13"
  },
  "authors": [
    {
      "name": "phoenix1cold",
      "url": "https://github.com/phoenix1cold"
    }
  ],
  "esmodules": [
    "scripts/main.mjs"
  ],
  "styles": [
    "styles/hub.css",
    "styles/shared-ui.css"
  ],
  "socket": true,
  "languages": [
    {
      "lang": "en",
      "name": "English",
      "path": "lang/en.json"
    },
    {
      "lang": "ru",
      "name": "Русский",
      "path": "lang/ru.json"
    },
    {
      "lang": "fr",
      "name": "Français",
      "path": "lang/fr.json"
    },
    {
      "lang": "zh",
      "name": "Chinese Simplified",
      "path": "lang/zh.json"
    }
  ],
  "templates": [
    "templates/hub-panel.hbs"
  ],
  "flags": {
    "ddLocalBuild": true
  },
  "url": "https://github.com/phoenix1cold/drama-director-hub",
  "readme": "https://github.com/phoenix1cold/drama-director-hub/blob/main/README.md",
  "bugs": "https://github.com/phoenix1cold/drama-director-hub/issues"
}
